{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scriptax",
  "version": "0.1.1",
  "identifier": "app.scriptax",
  "build": {
    "beforeDevCommand": {
      "script": "node scripts/tauri-npm.mjs dev",
      "cwd": "../"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "node scripts/tauri-npm.mjs build",
      "cwd": "../"
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scriptax",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
